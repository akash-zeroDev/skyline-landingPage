# Skyline Digital Media — Contact Form SMTP Configuration
#
# When left blank or unconfigured in local development, the app automatically
# falls back to Nodemailer Ethereal and prints a live clickable email preview URL in the console.

# SMTP Server Settings (e.g., smtp.gmail.com, smtp.resend.com, smtp.sendgrid.net)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Specific from-address and designated inbox
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=
